{
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "netlify/**/*.ts",
    "netlify/**/*.mts",
    "src/trigger/**/*.ts",
    "trigger.config.ts",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "server/**/*.ts"
  ]
}
