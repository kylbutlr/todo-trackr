# Use a pooled Neon connection for runtime queries.
DATABASE_URL=postgresql://role:password@host-pooler.example/neondb?sslmode=require

# Generate with: npm run auth:hash
TODO_TRACKER_PASSWORD_HASH=scrypt$base64_salt$base64_hash

# Generate with: openssl rand -base64 48
SESSION_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Shortcut REST API token used only by Todo Trackr's read-only source client.
SHORTCUT_API_TOKEN=replace-with-a-shortcut-api-token

# Generate with: openssl rand -base64 48
# Validates Shortcut's Payload-Signature in Automatic mode.
SHORTCUT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
GRANOLA_API_KEY=grn_replace-with-a-granola-api-key
GRANOLA_WEBHOOK_SECRET=whsec_replace-after-registering-the-webhook

# Optional repair safety nets. Set either value to false to prevent that
# scheduled handler from invoking its repair endpoint. Webhooks remain active.
TODO_TRACKER_SHORTCUT_REPAIR_ENABLED=true
TODO_TRACKER_GRANOLA_REPAIR_ENABLED=true

# Generate with: openssl rand -base64 48
# Used only by trusted server-to-server action ingestion.
TODO_TRACKR_INGEST_TOKEN=replace-with-a-random-ingest-token

# Netlify server key used to schedule and cancel delayed Trigger.dev alarm runs.
TRIGGER_SECRET_KEY=tr_replace-with-the-environment-specific-secret-key

# Configure these two values in the Trigger.dev environment. Use the same ingest
# token already configured in Netlify so the callback remains server-to-server.
TODO_TRACKR_TRIGGER_CALLBACK_URL=https://todotrackr.netlify.app/api/ingest/task-alarms
# TODO_TRACKR_INGEST_TOKEN=replace-with-the-same-random-ingest-token

# Optional shared work switch. Server-only; both absent keeps existing behavior.
APP_SWITCHR_URL=
APP_SWITCHR_READER_TOKEN=
