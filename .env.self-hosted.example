# Copy to the ignored .env.self-hosted file. Never commit the completed file.
TODO_TRACKER_RUNTIME=standalone
TODO_TRACKER_PUBLIC_ORIGIN=http://127.0.0.1:8888
TODO_TRACKER_HOST=127.0.0.1
TODO_TRACKER_PORT=8888

# Generate a unique hexadecimal database password: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-unique-hexadecimal-password
# Direct Node installations must set their own PostgreSQL URL. Compose overrides it.
DATABASE_URL=postgresql://todo_trackr:replace-with-a-unique-hexadecimal-password@127.0.0.1:5432/todo_trackr

# Explicit options: password or none. Missing/invalid secrets never enable none.
TODO_TRACKER_AUTH_MODE=password
# Generate with npm run auth:hash. Keep the single quotes around a scrypt hash.
TODO_TRACKER_PASSWORD_HASH=''
# Generate with openssl rand -hex 32.
SESSION_SIGNING_SECRET=

# Only set true for a deliberately private container/network boundary when using
# passwordless mode with a listener other than loopback. This does not add auth.
TODO_TRACKER_ALLOW_UNAUTHENTICATED_REMOTE=false
